*.py[cod]
*.so
*.egg-info/
*.egg
build/
dist/
wheels/

# --- Venv
.venv/
venv/
env/
ENV/

# --- Jupyter
.ipynb_checkpoints/
notebooks/*-checkpoint.ipynb

# --- IDE/editors
.vscode/*
!.vscode/settings.json
.idea/
*.iml

# --- ОС-trash
.DS_Store
._*
Thumbs.db
Desktop.ini

