coverage.xml
*.cover

# ========================
# Data and Model Files
# ========================
# Ignore dataset(s)
data/*.csv
data/*.xlsx
data/*.zip
# Keep important metadata
!data/README.md
!data/.gitkeep

# Ignore trained model files
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
# Keep documentation
!models/README.md
!models/.gitkeep
